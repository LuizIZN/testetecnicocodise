@model TesteTecnico.Application.Dtos.QueryResponse<
    TesteTecnico.Application.Dtos.GetAnimeResponse>

@{
    ViewData["Title"] = "Animes";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Animes</h3>
    </div>

    <div class="card-body">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Ano de lançamento</th>
                    <th>Episódios</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var anime in Model.Items)
                {
                    <tr>
                        <td>@anime.Nome</td>
                        <td>@anime.AnoLancamento</td>
                        <td>@anime.NumeroEpisodios</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>