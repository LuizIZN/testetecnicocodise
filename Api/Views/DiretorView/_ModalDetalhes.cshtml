@model TesteTecnico.Application.Dtos.GetDiretorResponse

<div
    class="modal fade"
    id="modalDetalhesDiretor-@Model.Id"
    tabindex="-1"
    aria-labelledby="modalDetalhesDiretorLabel-@Model.Id"
    aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalDetalhesDiretorLabel-@Model.Id">
                    Detalhes do Diretor
                </h5>
                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Fechar">
                </button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label ">Nome:</label>
                    <p>@Model.Nome</p>
                </div>
                <div class="mb-3">
                    <label class="form-label">Data de Nascimento:</label>
                    <p>@Model.DataNascimento</p>
                </div>
            </div>
        </div>
    </div>
</div>
