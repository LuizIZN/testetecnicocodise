@model TesteTecnico.Application.Dtos.QueryResponse<
    TesteTecnico.Application.Dtos.GetDiretorResponse>

@{
    ViewData["Title"] = "Diretores";
}

<div class="card">
    <div class="card-header d-flex w-full justify-content-between align-items-center">
        <h1 class="card-text">Diretores</h1>
        <button class="btn btn-primary" onclick="window.location.href='/diretores/novo'">Novo Diretor</button>
    </div>

    <div class="card-body d-flex flex-row flex-wrap justify-content-center align-items-center gap-3">
        @foreach (var diretor in Model.Items)
        {
            <div class="card mb-3">
                <div class="card-body d-flex flex-column justify-content-start align-items-start gap-2">
                    <h5 class="card-title">@diretor.Nome</h5>
                    <p class="card-text">Data de Nascimento: @diretor.DataNascimento</p>
                    <button class="btn btn-primary" onclick="window.location.href='/diretores/@diretor.Id'">Detalhes</button>
                </div>
            </div>
        }
    </div>
</div>