<div class="modal fade justify-content-center" id="modalNovoDiretor" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Novo Diretor</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <form method="post" action="/api/diretor" id="formNovoDiretor" class="d-flex flex-column gap-3">
                    <input
                        class="form-control"
                        type="text"
                        name="Nome"
                        required
                        maxlength="200"
                        placeholder="Nome do diretor..."
                        aria-label="Nome do diretor..." />
                    <input
                        class="form-control"
                        type="date"
                        name="DataNascimento"
                        required
                        max="@DateTime.Now.ToString("yyyy-MM-dd")"
                        aria-label="Data de nascimento do diretor" />
                    <button class="btn btn-primary" type="submit">Salvar</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById("formNovoDiretor").addEventListener("submit", async function (event) {
        event.preventDefault();

        const form = event.target;
        const response = await fetch(form.action, {
            method: form.method,
            body: new FormData(form)
        });

        if (response.ok) {
            bootstrap.Modal.getInstance(document.getElementById("modalNovoDiretor")).hide();
            alert("Diretor cadastrado!");
            location.reload();
            return;
        }

        const errorData = await response.json();
        const messages = Object.values(errorData.errors ?? {})
            .flat()
            .join(" ");
        alert("Erro ao salvar o diretor: " + (messages || errorData.title));
    });
</script>
