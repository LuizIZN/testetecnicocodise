@model TesteTecnico.Application.Dtos.GetDiretorResponse

<div
    class="modal fade"
    id="modalEditarDiretor-@Model.Id"
    tabindex="-1"
    aria-labelledby="modalEditarDiretorLabel-@Model.Id"
    aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalEditarDiretorLabel-@Model.Id">
                    Editar Diretor
                </h5>
                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Fechar">
                </button>
            </div>
            <form action="/api/diretor/@Model.Id" id="formEditarDiretor-@Model.Id" method="post" class="modal-body d-flex flex-column gap-3">
                <div class="mb-3">
                    <label class="form-label" for="Nome">Nome:</label>
                    <input
                        class="form-control"
                        type="text"
                        name="Nome"
                        value="@Model.Nome"
                        placeholder="Digite o nome do diretor..."
                        aria-label="Digite o nome do diretor..." />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="DataNascimento">Data de Nascimento:</label>
                    <input
                        class="form-control"
                        type="date"
                        name="DataNascimento"
                        value="@Model.DataNascimento.ToString("yyyy-MM-dd")"
                        placeholder="Digite a data de nascimento do diretor..."
                        aria-label="Digite a data de nascimento do diretor..." />
                </div>
                <div class="d-flex justify-content-end gap-3 align-items-center">
                    <button
                        type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                        Cancelar
                    </button>
                    <button
                        type="submit"
                        class="btn btn-primary">
                        Salvar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.getElementById("formEditarDiretor-@Model.Id").addEventListener("submit", async function (event) {
        event.preventDefault();

        const form = event.target;
        const response = await fetch(form.action, {
            method: "PATCH",
            body: new FormData(form)
        });

        if (response.ok) {
            bootstrap.Modal.getInstance(document.getElementById("modalEditarDiretor-@Model.Id")).hide();
            alert("Diretor atualizado!");
            location.reload();
            return;
        }

        const errorData = await response.json();
        const messages = Object.values(errorData.errors ?? {})
            .flat()
            .join(" ");
        alert("Erro ao salvar alterações: " + (messages || errorData.title));
    });
</script>
