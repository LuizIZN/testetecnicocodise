@model TesteTecnico.Application.Dtos.GetAnimeResponse

<div class="modal fade" id="modalDetalhes-@Model.Id" tabindex="-1"
     aria-labelledby="modalDetalhesLabel-@Model.Id" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <div>
                    <p class="mb-1 text-white-50 text-uppercase small fw-semibold">Anime</p>
                    <h5 class="modal-title" id="modalDetalhesLabel-@Model.Id">@Model.Nome</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Fechar"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-4">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="col-md-5">
                            <div class="rounded p-2 text-center h-100">
                                <img src="@Model.ImageUrl" alt="@Model.Nome"
                                     class="img-fluid rounded h-100 w-100"
                                     style="max-height: 500px; object-fit: cover;" />
                            </div>
                        </div>
                    }
                    <div class="@(string.IsNullOrEmpty(Model.ImageUrl) ? "col-12" : "col-md-7")">
                        <div class="mb-4">
                            <h6 class="text-uppercase text-muted small fw-bold">Descrição</h6>
                            <p class="mb-0" style="text-align: justify;">@Model.Descricao</p>
                        </div>
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <div class="border rounded p-3 h-100">
                                    <span class="text-muted small d-block">Ano de lançamento</span>
                                    <span class="fs-5 fw-semibold">@Model.AnoLancamento</span>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="border rounded p-3 h-100">
                                    <span class="text-muted small d-block">Episódios</span>
                                    <span class="fs-5 fw-semibold">@Model.NumeroEpisodios</span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="border rounded p-3">
                                    <span class="text-muted small d-block">Diretor</span>
                                    <span class="fw-semibold">@Model.Diretor.Nome</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>