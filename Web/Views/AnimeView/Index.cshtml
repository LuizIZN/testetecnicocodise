@model TesteTecnico.Web.ViewModels.AnimeViewModel

@{
    ViewData["Title"] = "Animes";
    var totalPages = Model.Animes.PageSize > 0
        ? (int)Math.Ceiling((double)Model.Animes.TotalCount / Model.Animes.PageSize)
        : 1;
    var nome = Context.Request.Query["Nome"].ToString();
    var anoLancamentoMin = Context.Request.Query["AnoLancamentoMin"].ToString();
    var anoLancamentoMax = Context.Request.Query["AnoLancamentoMax"].ToString();
    var numeroEpisodiosMin = Context.Request.Query["NumeroEpisodiosMin"].ToString();
    var numeroEpisodiosMax = Context.Request.Query["NumeroEpisodiosMax"].ToString();
}

<div class="card">
    <div class="card-header d-flex w-100 justify-content-start align-items-center">
        <h1 class="card-text me-auto mb-0">Animes</h1>
        <button class="btn btn-primary btn-lg" data-bs-toggle="modal" data-bs-target="#modalNovoAnime">Novo Anime</button>
    </div>

    <div class="card-body w-100 d-flex flex-row flex-wrap justify-content-start align-items-center gap-3">
        <form method="get" action="/animes" class="d-flex w-100 gap-4">
            <input
                class="form-control"
                type="search"
                name="Nome"
                value="@Context.Request.Query["Nome"]"
                placeholder="Pesquisar por nome..."
                aria-label="Pesquisar por nome..." />
            <input
                class="form-control"
                type="number"
                name="AnoLancamentoMin"
                value="@Context.Request.Query["AnoLancamentoMin"]"
                min="1900"
                max="@DateTime.Now.Year"
                placeholder="Pesquisar por ano de lançamento (min)..."
                aria-label="Pesquisar por ano de lançamento (min)..." />
            <input
                class="form-control"
                type="number"
                name="AnoLancamentoMax"
                min="1900"
                max="@DateTime.Now.Year"
                value="@Context.Request.Query["AnoLancamentoMax"]"
                placeholder="Pesquisar por ano de lançamento (max)..."
                aria-label="Pesquisar por ano de lançamento (max)..." />
            <input
                class="form-control"
                type="number"
                name="NumeroEpisodiosMin"
                min="1"
                value="@Context.Request.Query["NumeroEpisodiosMin"]"
                placeholder="Pesquisar por número de episódios (min)..."
                aria-label="Pesquisar por número de episódios (min)..." />
            <input
                class="form-control"
                type="number"
                name="NumeroEpisodiosMax"
                min="1"
                value="@Context.Request.Query["NumeroEpisodiosMax"]"
                placeholder="Pesquisar por número de episódios (max)..."
                aria-label="Pesquisar por número de episódios (max)..." />
            <select class="form-select" name="PageSize" aria-label="Tamanho da página">
                @foreach (var pageSize in new[] { 10, 25, 50, 100 })
                {
                    <option value="@pageSize" selected="@(Model.Animes.PageSize == pageSize)">
                        @pageSize
                    </option>
                }
            </select>
            <button class="btn btn-outline-primary" type="submit">
                Buscar
            </button>
            <button class="btn btn-outline-secondary" type="button" onclick="window.location.href='/animes'">
                Limpar
            </button>
        </form>

        @if (totalPages > 1)
{
    <nav>
        <ul class="pagination">
            <li class="page-item @(Model.Animes.PageNumber == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-controller="DiretorView"
                   asp-route-Nome="@nome"
                   asp-route-PageNumber="@(Model.Animes.PageNumber - 1)"
                   asp-route-PageSize="@Model.Animes.PageSize">
                    Anterior
                </a>
            </li>

            @for (var currentPage = 1; currentPage <= totalPages; currentPage++)
            {
                <li class="page-item @(currentPage == Model.Animes.PageNumber ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-controller="AnimeView"
                       asp-route-Nome="@nome"
                       asp-route-PageNumber="@currentPage"
                       asp-route-PageSize="@Model.Animes.PageSize">
                        @currentPage
                    </a>
                </li>
            }

            <li class="page-item @(Model.Animes.PageNumber >= totalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-controller="AnimeView"
                   asp-route-Nome="@nome"
                   asp-route-PageNumber="@(Model.Animes.PageNumber + 1)"
                   asp-route-PageSize="@Model.Animes.PageSize">
                    Próxima
                </a>
            </li>
        </ul>
    </nav>
}
    </div>

    <div class="card-body">
        <div class="row g-3">
        @foreach (var anime in Model.Animes.Items)
        {
            <div class="col-12 col-sm-6 col-lg-5 col-xl-2">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column align-items-start gap-2">
                        @if (!string.IsNullOrEmpty(anime.ImageUrl))
                        {
                            <img
                                src="@anime.ImageUrl"
                                class="card-img-top"
                                alt="@anime.Nome"
                                style="max-height: 200px; object-fit: cover;" />
                        }
                        <h5 class="card-title">@anime.Nome</h5>
                        <p class="card-text">Ano de Lançamento: @anime.AnoLancamento</p>
                        <div class="mt-auto d-flex gap-2 w-100 justify-content-center">
                            <button
                                class="btn btn-outline-primary"
                                type="button"
                                data-bs-toggle="modal"
                                data-bs-target="#modalDetalhes-@anime.Id">
                                Detalhes
                            </button>
                            <button
                                class="btn btn-outline-success"
                                type="button"
                                data-bs-toggle="modal"
                                data-bs-target="#modalEditar-@anime.Id">
                                Editar
                            </button>
                            <form method="post" action="/animes/@anime.Id/excluir"
                                  onsubmit="return confirm('Tem certeza que deseja excluir este anime?');">
                                <button class="btn btn-outline-danger" type="submit">Excluir</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (!Model.Animes.Items.Any())
        {
            <div class="col-12">
                <p class="text-center">Nenhum anime encontrado.</p>
            </div>
        }
        </div>
    </div>
</div>

<partial name="_ModalNovoAnime" model="Model.Diretores" />
@{
    ViewBag.Diretores = Model.Diretores.Items;
}
@foreach (var anime in Model.Animes.Items)
{
    <partial name="_ModalDetalhes" model="anime" />
    <partial name="_ModalEditar" model="anime" />
}
