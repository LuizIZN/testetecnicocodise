@model TesteTecnico.Application.Dtos.QueryResponse<
TesteTecnico.Application.Dtos.GetDiretorResponse >

<div class="modal fade justify-content-center" data-bs-backdrop="static" data-bs-keyboard="false" id="modalNovoAnime"
     tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <div>
                    <p class="mb-1 text-white-50 text-uppercase small fw-semibold">Anime</p>
                    <h5 class="modal-title">Novo Anime</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Fechar"></button>
            </div>
            <div class="modal-body p-4">
                <form method="post" action="/animes" enctype="multipart/form-data"
                      class="d-flex flex-column gap-3">
                    <div>
                        <label class="form-label" for="Imagem">Imagem</label>
                        <input class="form-control" id="Imagem" type="file" name="Imagem"
                               accept="image/jpeg,image/png,image/webp" aria-label="Imagem do anime" />
                        <div id="imagemPreviewContainer" class="mt-3 d-none">
                            <p class="form-label mb-2">Pré-visualização</p>
                            <img id="imagemPreview" class="img-fluid rounded border" alt="Pré-visualização da imagem do anime"
                                 style="max-height: 120px; max-width: 180px; object-fit: contain;" />
                            <button id="removerImagemButton" type="button"
                                    class="btn btn-sm btn-outline-danger d-block mt-2">
                                Remover imagem
                            </button>
                        </div>
                    </div>
                    <div>
                        <label class="form-label" for="Nome">Nome</label>
                        <input class="form-control" id="Nome" type="text" name="Nome" required maxlength="200"
                               placeholder="Nome do anime..." aria-label="Nome do anime..." />
                    </div>
                    <div class="d-flex gap-3">
                        <div class="w-50">
                            <label class="form-label" for="AnoLancamento">Ano de lançamento</label>
                            <input class="form-control" id="AnoLancamento" type="number" name="AnoLancamento" required
                                   min="1901" max="@DateTime.Now.Year" placeholder="Ano de lançamento..."
                                   aria-label="Ano de lançamento..." />
                        </div>
                        <div class="w-50">
                            <label class="form-label" for="NumeroEpisodios">Número de episódios</label>
                            <input class="form-control" id="NumeroEpisodios" type="number" name="NumeroEpisodios"
                                   required min="1" placeholder="Número de episódios..."
                                   aria-label="Número de episódios..." />
                        </div>
                    </div>
                    <div>
                        <label class="form-label" for="DiretorId">Diretor</label>
                        <select class="form-select" id="DiretorId" name="DiretorId" aria-label="Diretor" required>
                            <option value="" selected disabled>Selecione um diretor...</option>
                            @foreach (var diretor in Model.Items)
                            {
                                <option value="@diretor.Id">@diretor.Nome</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label" for="Descricao">Descrição</label>
                        <textarea class="form-control" id="Descricao" name="Descricao" required maxlength="500"
                                  placeholder="Descrição do anime..." aria-label="Descrição do anime..."></textarea>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button class="btn btn-secondary me-2" type="button" data-bs-dismiss="modal">Cancelar</button>
                        <button class="btn btn-primary" type="submit">Salvar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    (() => {
        const modalNovoAnime = document.getElementById('modalNovoAnime');
        const form = modalNovoAnime.querySelector('form');
        const imagemInput = modalNovoAnime.querySelector('#Imagem');
        const imagemPreviewContainer = modalNovoAnime.querySelector('#imagemPreviewContainer');
        const imagemPreview = modalNovoAnime.querySelector('#imagemPreview');
        const removerImagemButton = modalNovoAnime.querySelector('#removerImagemButton');
        let imagemPreviewUrl;

        const limparImagem = (limparCampo = true) => {
            if (limparCampo) {
                imagemInput.value = '';
            }

            imagemPreviewContainer.classList.add('d-none');
            imagemPreview.removeAttribute('src');

            if (imagemPreviewUrl) {
                URL.revokeObjectURL(imagemPreviewUrl);
                imagemPreviewUrl = undefined;
            }
        };

        imagemInput.addEventListener('change', () => {
            const arquivo = imagemInput.files[0];
            limparImagem(false);

            if (!arquivo || !arquivo.type.startsWith('image/')) {
                return;
            }

            imagemPreviewUrl = URL.createObjectURL(arquivo);
            imagemPreview.src = imagemPreviewUrl;
            imagemPreviewContainer.classList.remove('d-none');
        });

        modalNovoAnime.addEventListener('hidden.bs.modal', () => {
            form.reset();
            limparImagem();
        });

        removerImagemButton.addEventListener('click', limparImagem);
    })();
</script>