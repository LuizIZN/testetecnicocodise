<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/Anime-API-Logo-_-Favicon-_2_.ico" />
    <title>@ViewData["Title"] - Anime API</title>
    <adminlte-styles></adminlte-styles>
    <style>
        .app-wrapper {
            min-height: 100vh;
            grid-template-rows: auto minmax(0, 1fr);
            grid-template-areas:
                "lte-app-header lte-app-header"
                "lte-app-sidebar lte-app-main";
        }

        .app-sidebar {
            position: sticky;
            top: 0;
            align-self: start;
            height: 100vh !important;
            max-height: 100vh;
            overflow-y: auto;
        }

        .sidebar-brand {
            height: 5rem;
            padding: 1rem 1.25rem;
            background-color: transparent;
            border-bottom: 0;
        }

        .sidebar-brand .brand-link .brand-image,
        .sidebar-brand .brand-link .brand-image-xl {
            max-height: 80px;
            box-shadown: none;
        }

        .sidebar-toggle {
            display: none;
        }

        .sidebar-close {
            display: none;
        }

        @@media (max-width: 991.98px) {
            .sidebar-toggle {
                display: inline-flex;
                position: fixed;
                top: 0.75rem;
                left: 0.75rem;
                z-index: 1040;
                align-items: center;
                justify-content: center;
                width: 2.75rem;
                height: 2.75rem;
            }

            .sidebar-close {
                display: inline-flex;
                position: absolute;
                top: 1.375rem;
                right: 0.75rem;
                z-index: 1040;
                align-items: center;
                justify-content: center;
                width: 2.25rem;
                height: 2.25rem;
                transform: translateY(-50%);
            }

            body.sidebar-open .sidebar-toggle {
                display: none;
            }

            .app-main {
                padding-top: 3.5rem;
            }
        }
    </style>
</head>
<body class="layout-fixed sidebar-expand-lg">
    <button class="btn btn-primary sidebar-toggle"
            type="button"
            data-lte-toggle="sidebar"
            aria-label="Abrir menu"
            title="Abrir menu">
        <i class="bi bi-list" aria-hidden="true"></i>
    </button>

    <div class="app-wrapper">
        <aside class="app-sidebar h-100" data-bs-theme="light">
            <button class="btn btn-outline-secondary sidebar-close"
                    type="button"
                    data-lte-toggle="sidebar"
                    aria-label="Fechar menu"
                    title="Fechar menu">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
            <adminlte-sidebar class="h-100"></adminlte-sidebar>
        </aside>

        <main class="app-main">
            <div class="app-content">
                <div class="container-fluid py-3">
                    @RenderBody()
                </div>
            </div>
        </main>
    </div>

    <partial name="_ModalConfirmacao" />
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <partial name="_ModalAlerta" model="errorMessage" />
    }
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <partial name="_ModalSucesso" model="successMessage" />
    }

    <adminlte-scripts></adminlte-scripts>
    <script>
        (() => {
            const modalConfirmacao = document.getElementById('modalConfirmacao');
            const mensagemConfirmacao = document.getElementById('modalConfirmacaoMensagem');
            const botaoConfirmar = document.getElementById('confirmarAcao');
            let formularioPendente;

            document.querySelectorAll('form[data-confirmacao]').forEach((formulario) => {
                formulario.addEventListener('submit', (evento) => {
                    evento.preventDefault();
                    formularioPendente = formulario;
                    mensagemConfirmacao.textContent = formulario.dataset.confirmacao;
                    bootstrap.Modal.getOrCreateInstance(modalConfirmacao).show();
                });
            });

            botaoConfirmar.addEventListener('click', () => {
                if (formularioPendente) {
                    const formulario = formularioPendente;
                    formularioPendente = null;
                    formulario.submit();
                }
            });

            modalConfirmacao.addEventListener('hidden.bs.modal', () => {
                formularioPendente = null;
            });
        })();
    </script>
    @if (TempData["ErrorMessage"] is string)
    {
        <script>
            bootstrap.Modal.getOrCreateInstance(document.getElementById('modalAlerta')).show();
        </script>
    }
    @if (TempData["SuccessMessage"] is string)
    {
        <script>
            bootstrap.Modal.getOrCreateInstance(document.getElementById('modalSucesso')).show();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
