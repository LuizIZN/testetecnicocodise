<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Anime API</title>
    <adminlte-styles></adminlte-styles>
    <style>
        .app-wrapper {
            min-height: 100vh;
            grid-template-rows: auto minmax(0, 1fr);
            grid-template-areas:
                "lte-app-header lte-app-header"
                "lte-app-sidebar lte-app-main";
        }

        .app-sidebar {
            position: sticky;
            top: 0;
            align-self: start;
            height: 100vh !important;
            max-height: 100vh;
            overflow-y: auto;
        }
    </style>
</head>
<body class="layout-fixed">
    <div class="app-wrapper">
        <aside class="app-sidebar bg-body-primary h-100 shadow" data-bs-theme="light">
            <adminlte-sidebar class="h-100"></adminlte-sidebar>
        </aside>

        <main class="app-main">
            <div class="app-content">
                <div class="container-fluid py-3">
                    @RenderBody()
                </div>
            </div>
        </main>
    </div>

    <partial name="_ModalConfirmacao" />
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <partial name="_ModalAlerta" model="errorMessage" />
    }

    <adminlte-scripts></adminlte-scripts>
    <script>
        (() => {
            const modalConfirmacao = document.getElementById('modalConfirmacao');
            const mensagemConfirmacao = document.getElementById('modalConfirmacaoMensagem');
            const botaoConfirmar = document.getElementById('confirmarExclusao');
            let formularioPendente;

            document.querySelectorAll('.js-confirmar-exclusao').forEach((botao) => {
                botao.addEventListener('click', () => {
                    formularioPendente = botao.closest('form');
                    mensagemConfirmacao.textContent = botao.dataset.mensagem;
                    bootstrap.Modal.getOrCreateInstance(modalConfirmacao).show();
                });
            });

            botaoConfirmar.addEventListener('click', () => {
                if (formularioPendente) {
                    formularioPendente.submit();
                }
            });

            modalConfirmacao.addEventListener('hidden.bs.modal', () => {
                formularioPendente = null;
            });
        })();
    </script>
    @if (TempData["ErrorMessage"] is string)
    {
        <script>
            bootstrap.Modal.getOrCreateInstance(document.getElementById('modalAlerta')).show();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
